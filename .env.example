# Export these variables in your shell. This file is documentation, not auto-loaded.
JARVIS_PROVIDER=offline
JARVIS_MODEL=phi3:mini
JARVIS_MODEL_URL=http://127.0.0.1:11434
# For an OpenAI-compatible endpoint, set provider=compatible and its /v1 base URL.
JARVIS_API_KEY=
# Optional search backend: Brave Search API; requests disclose the search query.
BRAVE_API_KEY=
# All file tools are confined to this directory.
JARVIS_WORKSPACE=
JARVIS_PORT=8765
# Comma-separated exact hostnames permitted for research and browser tools.
JARVIS_NETWORK_HOSTS=docs.python.org,en.wikipedia.org
JARVIS_DESKTOP_ENABLED=false
JARVIS_PROACTIVE=false
